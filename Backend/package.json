{
  "name": "peoplepay360-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "db:generate": "prisma generate --schema ../Database/prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy --schema ../Database/prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "demo:seed": "node --env-file=.env scripts/seed-demo.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.3.4",
    "nodemailer": "^7.0.6",
    "puppeteer": "^24.26.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  },
  "type": "module"
}
