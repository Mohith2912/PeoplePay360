  grossEarnings      Decimal       @db.Decimal(18, 2)
  grossDeductions    Decimal       @db.Decimal(18, 2)
  netPay             Decimal       @db.Decimal(18, 2)
  totalReimbursement Decimal       @db.Decimal(18, 2)
  netTransfer        Decimal       @db.Decimal(18, 2)
  status             PayslipStatus
  paidAt             DateTime?
  emailedAt          DateTime?
