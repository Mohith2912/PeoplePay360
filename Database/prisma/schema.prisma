generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  NOTICE_PERIOD
  TERMINATED
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum ScheduleType {
  STANDARD
  SHIFT
  FLEXIBLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCEPTION
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum AllocationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  CONTRIBUTION
  NET
  REIMBURSEMENT
}

enum ComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum WarningEntityType {
  EMPLOYEE
  CONTRACT
  PAYRUN
  PAYSLIP
  ATTENDANCE
  TIME_OFF
}

enum WarningSeverity {
  INFO
  WARNING
  ERROR
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  employeeId   String?   @unique
  employee     Employee? @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs               AuditLog[]         @relation("AuditUser")
  attendanceCorrections   AttendanceRecord[] @relation("AttendanceCorrectedBy")
  approvedTimeOffRequests TimeOffRequest[]   @relation("TimeOffApprovedBy")
  payrunsCreated          Payrun[]           @relation("PayrunCreatedBy")
  resolvedWarnings        PayrollWarning[]   @relation("WarningResolvedBy")
}

model Employee {
  id                String           @id @default(cuid())
  employeeCode      String           @unique
  firstName         String
  lastName          String
  email             String
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  dateOfJoining     DateTime
  department        String
  designation       String
  employeeType      EmployeeType
  managerId         String?
  manager           Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates      Employee[]       @relation("EmployeeManager")
  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  status            EmployeeStatus
  pan               String?
  uan               String?
  pfNumber          String?
  esiNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankIFSC          String?
  location          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user               User?               @relation("EmployeeUser")
  contracts          Contract[]
  attendanceRecords  AttendanceRecord[]
  timeOffRequests    TimeOffRequest[]
  timeOffAllocations TimeOffAllocation[]
  payslips           Payslip[]
  payrunAssignments  PayrunEmployee[]

  @@index([email])
  @@index([department])
  @@index([status])
  @@index([employeeType])
  @@index([dateOfJoining])
}

model WorkingSchedule {
  id          String       @id @default(cuid())
  name        String
  type        ScheduleType
  weeklyHours Decimal      @default(0) @db.Decimal(8, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scheduleDays ScheduleDay[]
  employees    Employee[]
}

model ScheduleDay {
  id                String          @id @default(cuid())
  workingScheduleId String
  workingSchedule   WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)
  dayOfWeek         DayOfWeek
  isWorkingDay      Boolean         @default(true)
  startTime         DateTime?
  endTime           DateTime?
  breakMinutes      Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workingScheduleId, dayOfWeek])
  @@index([workingScheduleId])
}

model Contract {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startDate         DateTime
  endDate           DateTime?
  department        String
  designation       String
  wage              Decimal         @db.Decimal(18, 2)
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  status            ContractStatus
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([salaryStructureId])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date                DateTime
  checkIn             DateTime?
  checkOut            DateTime?
  workedHours         Decimal          @db.Decimal(10, 2)
  breakMinutes        Int              @default(0)
  status              AttendanceStatus
  isManuallyCorrected Boolean          @default(false)
  correctedByUserId   String?
  correctedByUser     User?            @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id], onDelete: SetNull)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model TimeOffType {
  id                 String      @id @default(cuid())
  name               String
  code               String      @unique
  unit               TimeOffUnit
  requiresAllocation Boolean     @default(true)
  approvalRequired   Boolean     @default(true)
  payrollIntegration Boolean     @default(false)
