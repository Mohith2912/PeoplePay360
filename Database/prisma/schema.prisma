model PayslipLine {
  id           String             @id @default(cuid())
  payslipId    String
  payslip      Payslip            @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  salaryRuleId String?
  salaryRule   SalaryRule?        @relation(fields: [salaryRuleId], references: [id], onDelete: SetNull)
  name         String
  code         String
  category     SalaryRuleCategory
  amount       Decimal            @db.Decimal(18, 2)
  sequence     Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([payslipId])
  @@index([salaryRuleId])
  @@index([category])
  @@index([sequence])
}

model PayrollWarning {
  id               String            @id @default(cuid())
  entityType       WarningEntityType
  entityId         String
  warningType      String
  message          String
  severity         WarningSeverity
  isResolved       Boolean           @default(false)
  resolvedByUserId String?
  resolvedByUser   User?             @relation("WarningResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([entityType])
  @@index([entityId])
  @@index([warningType])
  @@index([severity])
  @@index([isResolved])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  payslipId        String        @unique
  payslip          Payslip       @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  paymentReference String?
  paymentMethod    PaymentMethod
  paymentDate      DateTime?
  amount           Decimal       @db.Decimal(18, 2)
  status           PaymentStatus
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// Application-level rule: overlapping contracts for the same employee must be prevented in service logic.
// The payrun selection logic must use the active contract whose date range includes the payrun period.
// A working schedule must compute weeklyHours from its scheduleDays rather than trusting stored values directly.
// Salary formula values are not executed as JavaScript; they must be validated and evaluated in application logic.
// Leave allocation balances must be adjusted atomically within a database transaction in the application layer.
// Attendance corrected values must be validated to ensure workedHours is never negative.
